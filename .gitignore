# .gitignore — файлы и папки, которые git не должен отслеживать.
# Одна строка = одно правило. Строки с # — комментарии.

# Настройки Claude Code для этого проекта (локальные, не часть сайта)
.claude/

# Системный мусор macOS: Finder создаёт .DS_Store в каждой открытой папке
.DS_Store
._*
.Spotlight-V100
.Trashes

# Системный мусор Windows (если проект откроют там)
Thumbs.db
desktop.ini

# Настройки редакторов кода
.vscode/
.idea/
*.swp
*~

# Логи и временные файлы
*.log
*.tmp
